# Ignore-first allow-list: only repository source files are included.
**/*

# Root files
!.gitignore
!install.sh
!packages.json
!README.md

# Helper scripts and their documentation
!scripts/
!scripts/README.md
!scripts/setup-repositories.sh
!scripts/install-rust-tools.sh
!scripts/install-oh-my-zsh.sh
!scripts/install-fonts.sh
!scripts/stow-dotfiles.sh

# Managed configuration
!dotfiles/
!dotfiles/git/
!dotfiles/git/.gitconfig
!dotfiles/tmux/
!dotfiles/tmux/.config/
!dotfiles/tmux/.config/tmux/
!dotfiles/tmux/.config/tmux/tmux.conf
!dotfiles/vim/
!dotfiles/vim/.vimrc
!dotfiles/code/
!dotfiles/code/README.md
!dotfiles/code/.config/
!dotfiles/code/.config/Code/
!dotfiles/code/.config/Code/User/
