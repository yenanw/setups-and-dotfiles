!dotfiles/alacritty/.config/alacritty/themes/
!dotfiles/alacritty/.config/alacritty/themes/ganbaru_matcha.toml
!dotfiles/yazi/
!dotfiles/yazi/.config/
!dotfiles/yazi/.config/yazi/
!dotfiles/yazi/.config/yazi/yazi.toml
!dotfiles/zsh/
!dotfiles/zsh/.zshrc
!dotfiles/nvim/
