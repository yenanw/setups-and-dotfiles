" Use spaces and a four-column indent.
set expandtab
set softtabstop=4
set shiftwidth=4
set tabstop=4

" Line numbers and automatic indentation.
set number
set autoindent
set smartindent

" Keep the preferred line lengths visible.
set colorcolumn=80,120
highlight ColorColumn ctermbg=234 guibg=#1c1c1c
