// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+shift+-",
        "command": "-workbench.action.navigateForward",
        "when": "canNavigateForward"
    },
    {
        "key": "ctrl+shift+=",
        "command": "-workbench.action.browser.zoomIn",
        "when": "browserFocused && browserHasUrl && !browserHasError && activeEditor == 'workbench.editor.browser'"
    },
    {
        "key": "ctrl+shift+=",
        "command": "-workbench.action.zoomIn"
    },
    {
        "key": "ctrl+shift+-",
        "command": "editor.action.fontZoomOut",
        "when": "!terminalFocus"
    },
    {
        "key": "ctrl+shift+=",
        "command": "editor.action.fontZoomIn",
        "when": "!terminalFocus"
    },
    {
        "key": "ctrl+shift+0",
        "command": "editor.action.fontZoomReset",
        "when": "!terminalFocus"
    },
    {
        "key": "ctrl+shift+-",
        "command": "workbench.action.terminal.fontZoomOut",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+shift+=",
        "command": "workbench.action.terminal.fontZoomIn",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+shift+0",
        "command": "workbench.action.terminal.fontZoomReset",
        "when": "terminalFocus"
    }
]
